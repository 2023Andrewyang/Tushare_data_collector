# Tushare
TUSHARE_TOKEN=
TUSHARE_POINTS=5000          # 积分参数：>=6000 才采集东财板块接口

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stock_analysis
DB_USER=postgres
DB_PASSWORD=
DB_POOL_SIZE=5

# 数据范围
DATA_START_DATE=20200101
INCLUDE_BSE=true

# 日志
LOG_LEVEL=INFO
LOG_DIR=./logs

# 采集行为
MAX_RETRIES=3
RETRY_INTERVAL=30
